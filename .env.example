# 复制此文件为 .env 并填入你的密钥

# DeepSeek API（对话模型）
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=你的_deepseek_密钥

# 硅基流动 API（RAG Embedding 向量化 + 重排序 rerank 都用它）
# 获取地址：https://siliconflow.cn，BAAI/bge-m3 与 BAAI/bge-reranker-v2-m3 均免费
SILICONFLOW_API_KEY=你的_硅基流动_密钥

# 网站访问密码（middleware 门禁 + 登录接口共用，必填）
SITE_PASSWORD=你的访问密码

# 数据接口域名（可选：留空 = 使用站内 /api/mock；接真实企业 API 时填）
# DATA_API_BASE=https://真实企业域名/api

